node_modules/
dist/
build/
artifacts/
cache/
coverage/
typechain-types/
*.log
.env
.env.*
!.env.example
.DS_Store
deployments/local.json
# Live deployment written by the deploy scripts on the host that ran them.
# Untracked on purpose so `git reset --hard` can never revert a running server
# to older contract addresses; it takes precedence over the committed arc.json.
deployments/arc.local.json
.tessera-memory.json
.tessera-admin.json
.tessera-config.json
.tessera-profiles.json
# Per-host transaction ledger written at runtime — it records this deployment's
# own wallet activity, so it belongs to the machine, not the repo.
.tessera-txlog.json
# Persisted holder-address index. A cache rebuilt from the chain, never truth.
.tessera-holders.json
# Last good reserve read, so a restart does not start with an empty panel.
# Public market data only — never a position. Rebuilt from the chain, never truth.
.tessera-lending-market.json
# Which venue's emissions the pot guard paused, so it only ever undoes its own.
.tessera-emissions-guard.json
# Standing instructions: what this deployment does on its own, and when.
.tessera-tasks.json
.tessera-series.json
# Governance drafts and comments: operator-stored, wallet-signed, per-deployment.
.tessera-discussions.json
# Creation block per contract, found by binary search over getCode. Derived from
# the chain and specific to this deployment's addresses — a cache, never truth.
.tessera-deploy-blocks.json
deployments/arc.history.json
# Scratch directory for local QA scripts; never part of the app.
.tmpqa/

# Scratch trees created by agent/test/pool-arc.test.ts. They are removed when
# the test finishes; this catches the case where a run is interrupted.
.pool-arc-test-*/

# Records which holders a pool reset has already paid; deleting it and re-running
# would pay every one of them a second time.
deployments/reset-state.json
.qa/
deployments/.rehearsal.json
.tessera-log-scan.json
