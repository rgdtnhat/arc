{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless pay-per-use commerce for AI agents, settled on Arc in USDC.",
  "workspaces": [
    "shared",
    "contracts",
    "providers",
    "agent",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace contracts && npm run test --workspace agent",
    "compile": "npm run compile --workspace contracts",
    "abi:check": "node scripts/check-abi.mjs",
    "start": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx agent/src/dashboard.ts",
    "bootstrap:arc": "NODE_USE_ENV_PROXY=1 tsx scripts/arc-bootstrap.mjs",
    "pool:arc": "NODE_USE_ENV_PROXY=1 node --env-file=.env --import tsx scripts/pool-arc.mjs",
    "pool:arc:init": "npm run pool:arc -- --deploy-missing",
    "swap:fund": "NODE_USE_ENV_PROXY=1 node --env-file=.env --import tsx scripts/fund-swap.mjs",
    "audit": "npm audit --omit=dev && npm audit --audit-level=moderate",
    "deck": "node scripts/make-deck.mjs && node scripts/check-deck.mjs",
    "deck:check": "node scripts/check-deck.mjs",
    "deck:pdf": "soffice --headless --norestore --convert-to pdf --outdir docs docs/deck.pptx"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.8",
    "cookie": "^0.7.2",
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.7",
    "tmp": "^0.2.7",
    "undici": "^6.28.0",
    "uuid": "^11.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
