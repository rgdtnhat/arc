{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Trustless pay-per-use commerce for AI agents, settled on Arc in USDC.",
  "workspaces": [
    "shared",
    "contracts",
    "providers",
    "agent",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace contracts && npm run test --workspace agent",
    "compile": "npm run compile --workspace contracts",
    "demo": "npm run demo --workspace agent",
    "e2e": "TESSERA_ONCE=1 tsx agent/src/demo.ts",
    "bootstrap:arc": "tsx scripts/arc-bootstrap.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
