# Arc network (defaults to testnet). To migrate to mainnet, repoint these — the
# code path is identical; nothing else needs to change.
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# ERC-20 view of USDC on Arc (native gas token, 6 decimals for balances/transfers)
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Optional display / explorer overrides (used as-is for links + chain name).
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_CHAIN_NAME=Arc Testnet
ARC_IS_TESTNET=true      # set "false" for mainnet

# Optional RPC pacing (avoids the public endpoint's "request limit reached").
# All of these adapt at runtime — they are starting points, not promises. Leave
# them unset unless a private endpoint lets you be more generous.
#
# The limit Arc actually enforces is how many requests are open at once, not how
# fast they are started: fifteen back-to-back log scans are served, ten sent
# together are refused. So concurrency is the knob that matters and the rate is
# a safety net behind it.
#
# ARC_RPC_CONCURRENCY=6         # requests open at once (adapts between 2 and 8)
# ARC_RPC_RATE=12               # aggregate requests/second across all methods
# ARC_RPC_LOGS_RATE=6           # sub-limit for eth_getLogs, so background
#                               # scans cannot starve the reads on screen
ARC_RPC_MAX_RETRIES=6           # backoff attempts on a throttled/transient call
ARC_RPC_TIMEOUT_MS=12000        # per-request timeout
ARC_RPC_RETRY_BUDGET_MS=15000   # hard ceiling on one call incl. all backoff
#
# ARC_RPC_MIN_INTERVAL_MS is the old metronome and is still honoured (read as a
# rate of 1000/interval), but it is no longer the right shape: spacing calls out
# costs latency without buying anything the concurrency gate does not already
# buy. Unset it and let the defaults adapt.

# Deployer / agent / provider keys (testnet only — never commit real keys)
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=

# Deployed contract addresses (filled after deploy)
TESSERA_ESCROW_ADDRESS=
TESSERA_TAB_ADDRESS=

# Optional: enable LLM-driven agent decisions
ANTHROPIC_API_KEY=
AGENT_BRAIN=rules   # "rules" | "llm"

# Dashboard admin login (secret — never commit real values; only a hash is stored,
# in the gitignored .tessera-admin.json). Leave ADMIN_PASSWORD blank to disable.
ADMIN_ID=admin
ADMIN_PASSWORD=

# Optional platform "app wallet" (fee treasury). Secret — never commit. Only its
# public address is ever surfaced; its key stays here.
APP_WALLET_PRIVATE_KEY=
